# ============================================================================
# Docker Compose
# ============================================================================

# Port HTTP exposé par le conteneur frontend (Nginx) sur la machine hôte.
ADSB_HTTP_PORT=8000
ADSB_ADMIN_PORT=8082
ADSB_ADMIN_USER=admin
# Identifiants par défaut : admin / admin.
# À remplacer impérativement avant exposition réseau.
ADSB_ADMIN_PASSWORD=admin
ADSB_INTERNAL_TOKEN=change-me-internal-token

# ============================================================================
# Backend FastAPI
# ============================================================================

# Le backend écoute sur 0.0.0.0:8000 à l'intérieur du réseau Docker ; le
# frontend Nginx le joint via http://backend:8000. Aucun port backend n'est
# publié sur la machine hôte.

# Centre du scope et rayon de couverture
ADSB_LAT=46.8687
ADSB_LON=6.9416
ADSB_RADIUS_NM=50
ADSB_MAX_RADIUS_NM=150

# Rafraîchissement / cache
ADSB_REFRESH_MS=3000
ADSB_CACHE_TTL=4.0
ADSB_STALE_TTL=120
ADSB_FAILURE_BACKOFF=5.0
ADSB_TIMEOUT=4.0

# Sources : airplanes_live, adsb_lol ou none
# airplanes.live est la source primaire ; adsb.lol sert de secours si l'API
# primaire refuse l'accès (HTTP 403) ou est indisponible.
ADSB_PRIMARY_PROVIDER=airplanes_live
ADSB_FALLBACK_PROVIDER=adsb_lol
ADSB_PRIMARY_COOLDOWN=600

# Journalisation / CORS
ADSB_LOG_LEVEL=INFO
ADSB_CORS_ORIGINS=*

# Style du radar : phosphor, amber, ice ou mono
ADSB_RADAR_STYLE=phosphor

# Source METAR : aviationweather (sans clé) ou metar_taf
ADSB_METAR_PROVIDER=aviationweather
# Clé API https://metar-taf.com/docs (uniquement pour metar_taf)
METAR_TAF_API_KEY=
# Clé API https://www.checkwxapi.com/ (uniquement pour checkwx)
CHECKWX_API_KEY=
