# ============================================================================
# Docker Compose
# ============================================================================

# Port HTTP exposé par le conteneur frontend (Nginx) sur la machine hôte.
ADSB_HTTP_PORT=8000
ADSB_ADMIN_PORT=8082
ADSB_DESKTOP_PORT=8083
ADSB_TAR1090_PORT=8084
# Intervalle d'écriture des données JSON lues par tar1090, en secondes.
# 10 s limite les appels aux fournisseurs en ligne ; réduire en réception locale.
ADSB_TAR1090_WRITE_INTERVAL_S=10
ADSB_ADMIN_USER=admin
# Identifiants par défaut : admin / admin.
# À remplacer impérativement avant exposition réseau.
ADSB_ADMIN_PASSWORD=admin
ADSB_INTERNAL_TOKEN=change-me-internal-token

# ============================================================================
# Backend FastAPI
# ============================================================================

# Le backend écoute sur 0.0.0.0:8000 à l'intérieur du réseau Docker ; le
# frontend Nginx le joint via http://backend:8000. Aucun port backend n'est
# publié sur la machine hôte.

# Centre du scope et rayon de couverture
ADSB_LAT=46.8687
ADSB_LON=6.9416
ADSB_RADIUS_NM=50
ADSB_MAX_RADIUS_NM=150

# Rafraîchissement / cache
ADSB_REFRESH_MS=3000
ADSB_CACHE_TTL=4.0
ADSB_STALE_TTL=120
ADSB_FAILURE_BACKOFF=5.0
ADSB_TIMEOUT=4.0

# Sources : airplanes_live, adsb_lol ou none
# airplanes.live est la source primaire ; adsb.lol sert de secours si l'API
# primaire refuse l'accès (HTTP 403) ou est indisponible.
ADSB_PRIMARY_PROVIDER=airplanes_live
ADSB_FALLBACK_PROVIDER=adsb_lol
ADSB_PRIMARY_COOLDOWN=600

# Réception locale : online ou local.
# En mode local, le backend lit un aircraft.json dump1090/readsb.
ADSB_RECEPTION_MODE=online
# Exemple : http://192.168.30.25:8080/data/aircraft.json
ADSB_LOCAL_JSON_URL=
# Délai au-delà duquel la télémétrie locale est marquée "degraded" (secondes).
ADSB_LOCAL_STATS_STALE_S=30

# Journalisation / CORS
ADSB_LOG_LEVEL=INFO
ADSB_CORS_ORIGINS=*

# Style du radar : phosphor, mono ou atc
ADSB_RADAR_STYLE=phosphor
# Localisation : coords ou airport (avec ADSB_AIRPORT_ICAO)
ADSB_LOCATION_MODE=coords
ADSB_AIRPORT_ICAO=

# Source METAR : aviationweather (sans clé) ou metar_taf
ADSB_METAR_PROVIDER=aviationweather
# Clé API https://metar-taf.com/docs (uniquement pour metar_taf)
METAR_TAF_API_KEY=
# Clé API https://www.checkwxapi.com/ (uniquement pour checkwx)
CHECKWX_API_KEY=

# ============================================================================
# Statistiques persistantes (SQLite)
# ============================================================================

ADSB_STATS_ENABLED=true
# Intervalle d'échantillonnage du collecteur, en secondes.
ADSB_STATS_SAMPLE_SECONDS=30
# Durée de conservation de l'historique, en jours.
ADSB_STATS_RETENTION_DAYS=180
# Délai sans réception au-delà duquel un retour compte comme un nouveau passage.
ADSB_STATS_PASS_GAP_SECONDS=1800

# ============================================================================
# Export InfluxDB v2 (optionnel, surchargeable depuis l'administration)
# ============================================================================

ADSB_INFLUX_ENABLED=false
ADSB_INFLUX_URL=
ADSB_INFLUX_ORG=
ADSB_INFLUX_BUCKET=
ADSB_INFLUX_TOKEN=
ADSB_INFLUX_MEASUREMENT=adsb_stats
ADSB_INFLUX_INTERVAL_S=30
